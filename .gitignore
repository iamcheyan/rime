# ============================================
# Rime 配置仓库 .gitignore
# 原则：只提交「源配置」——schema/dict/lua/脚本/文档。
# 不提交：运行时产物（userdb 导出/编译缓存）、设备本地文件、临时文件。
# ============================================

# ---- Rime 本地运行时文件（每台设备各自生成，禁止提交）----
# 设备安装信息、本地用户配置（含密码/API key 等敏感字段）
installation.yaml
user.yaml

# Rime userdb 导出快照（顶层 *.txt = 各方案用户词库，Rime 同步时自动更新）
# 注意：sync/**/ 下的 .txt 是设备间词频同步载体，由 Rime 原生同步分发，
#       不通过 git 分发；如确需备份请用 rime_dict_manager -s 导出
*.userdb/
dynamic_freq.local.txt
# 顶层方案 userdb 导出（sbzr/sbzr_mix/jaroomaji/easy_en/pinyin 等）
/sbzr.txt
/sbzr_mix.txt
/jaroomaji.txt
/easy_en.txt
/pinyin.txt
# LevelDB 本地用户数据库
dynamic_freq.userdb/
*.userdb.txt

# Rime 编译产物
/build/

# ---- jaroomaji 日语大词库（外部下载生成，不随仓库分发）----
jaroomaji.user.dict.yaml
jaroomaji.kana_kigou.dict.yaml
jaroomaji.mozc.dict.yaml
jaroomaji.jmdict.dict.yaml
jaroomaji.mozcemoji.dict.yaml
jaroomaji.kanjidic2.dict.yaml
dict_backups_*/jaroomaji.*.dict.yaml
# External wordfreq resource caches
resource/jieba.dict.utf8
resource/rime_ice_dicts/

# ---- 编译缓存 / Python 产物 ----
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
*.o
*.a
*.so
*.dylib
*.exe
*.out

# ---- 日志 ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- 临时文件 ----
*.tmp
*.temp
*.cache
.cache/
*.orig
*.bak
*.bak*
*~
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# ---- 编辑器 / IDE ----
.idea/
.vscode/
.project
.classpath
.settings/

# ---- 操作系统生成文件 ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.directory
.Trash-*

# ---- 环境变量 / 密钥 ----
.env
.env.local
.env.*.local
*.env
*.env*

# ---- 运行时数据 ----
pids
*.pid
*.seed
*.pid.lock

# Rime 自身产生的运行目录（词库同步载体与回收站）
# 忽略 sync/ 下的所有运行时文件，但放行各设备的动态词频同步快照 dynamic_freq.txt
sync/*
!sync/*/
sync/*/*
!sync/*/dynamic_freq.txt
trash/
