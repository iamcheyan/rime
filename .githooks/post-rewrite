#!/bin/sh
# Auto-import dynamic frequency snapshot after git rebase

ROOT_DIR="$(git rev-parse --show-toplevel)"
cd "$ROOT_DIR" || exit 1

if [ -f "scripts/import-dynamic-freq.py" ]; then
    echo "[Hook: post-rewrite] Importing dynamic_freq sync snapshots..."
    python3 scripts/import-dynamic-freq.py
fi

if [ -x "scripts/install-jaroomaji-dicts.sh" ]; then
    echo "[Hook: post-rewrite] Checking external Japanese dictionaries..."
    ./scripts/install-jaroomaji-dicts.sh
fi

# post-rewrite also runs for `git commit --amend`; only rebuild after a rebase,
# which is the path used by `git pull --rebase`.
if [ "${1:-}" = "rebase" ] && [ -x "./rebuild" ]; then
    echo "[Hook: post-rewrite] Rebuilding Rime configuration after rebase..."
    ./rebuild
fi
